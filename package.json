{
  "name": "scheduler-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "node server.js",
    "postinstall": "prisma generate",
    "build": "vite build",
    "preview": "vite preview",
    "codemap:sync": "node scripts/hooks/generate-codemap.mjs",
    "experience:sync": "node scripts/hooks/update-experience-log.mjs",
    "docs:quality": "node scripts/hooks/run-docs-quality.mjs --write",
    "hooks:install": "node scripts/hooks/install-hooks.mjs",
    "hooks:pre-commit": "node scripts/hooks/pre-commit.mjs",
    "hooks:cline:test": "vitest run tests/clineHarnessProtocol.test.js tests/clineHarnessState.test.js tests/clineHarnessPolicy.test.js tests/clineHarnessGates.test.js tests/clineHarnessLifecycle.test.js tests/clineHarnessPerformance.test.js tests/clineHarnessDocs.test.js",
    "hooks:cline:benchmark": "node scripts/hooks/benchmark-cline-harness.mjs",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/",
    "test": "vitest",
    "test:run": "vitest run",
    "test:fast": "vitest run --exclude tests/nativeLanguagePreallocationRealScenarios.test.js --exclude tests/clineHarnessLifecycle.test.js --exclude tests/clineHarnessPerformance.test.js && vitest run tests/clineHarnessLifecycle.test.js && vitest run tests/clineHarnessPerformance.test.js",
    "test:solver": "vitest run tests/nativeLanguagePreallocationRealScenarios.test.js",
    "test:all": "npm run test:fast && npm run test:solver"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.7.0",
    "axios": "^1.15.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.9.0",
    "cors": "^2.8.6",
    "docx": "^9.6.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "file-saver": "^2.0.5",
    "pinia": "^3.0.4",
    "vue": "^3.5.31",
    "vue-router": "^5.0.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.57.0",
    "eslint-plugin-vue": "~10.8.0",
    "globals": "^17.4.0",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.57.0",
    "prettier": "3.8.1",
    "prisma": "^7.7.0",
    "vite": "^8.0.3",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
